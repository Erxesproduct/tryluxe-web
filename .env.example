# Canonical site URL (SEO, sitemap, Open Graph, QPay return page). On Vercel the production URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://tryluxe.mn

# -- erxes 3.0 (server only, never NEXT_PUBLIC_) -------------------------------------------------
# erxes gateway of the tryLuxé workspace
ERXES_API_URL=                  # https://<subdomain>.next.erxes.io/gateway

# Website orders (POST /api/orders) -> erxes form submission (public widgetsSaveLead) -> Sales card
ERXES_ORDER_FORM_ID=            # _id of the erxes form that receives website orders
ERXES_ORDER_FIELD_IDS=          # {"name":"<fieldId>","phone":"<fieldId>","email":"<fieldId>","message":"<fieldId>"}

# QPay through the erxes payment plugin (generateInvoiceUrl / invoicesCheck). The QPay merchant credentials
# are entered in erxes (Settings -> Payments), never here.
ERXES_PAYMENT_IDS=              # _id of the erxes QPay payment method (comma-separated if several)

# Newsletter sign-up (POST /api/newsletter) -> erxes form
ERXES_NEWSLETTER_FORM_ID=       # _id of the erxes sign-up form
ERXES_NEWSLETTER_EMAIL_FIELD_ID=  # _id of that form's email field
